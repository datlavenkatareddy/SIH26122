# Copy this file to frontend/.env — it is gitignored and must never be committed.

# URL of the FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Set to 'false' to make real API calls to the backend (recommended for dev).
# Set to 'true' only to run the frontend in isolation without any backend.
# WARNING: when true (or unset / misspelled), the app silently serves fake
# data for EVERY screen. A console.warn fires on app load to make this visible.
VITE_USE_MOCKS=false

# Optional — only needed if you have a live Supabase project.
# Leave blank to use the dev-mode login accounts (see README).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
