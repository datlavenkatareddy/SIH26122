# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Database (Supabase Postgres, direct connection — M6 sets up the shared project) ---
# Get this from Supabase dashboard > Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Supabase Auth ---
SUPABASE_URL=https://<PROJECT-REF>.supabase.co

# Publishable key (Supabase dashboard: SUPABASE_PUBLISHABLE_KEY or SUPABASE_ANON_KEY)
SUPABASE_ANON_KEY=

# Secret key (Supabase dashboard: SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWKS URL for asymmetric JWT verification (ES256)
SUPABASE_JWKS_URL=https://<PROJECT-REF>.supabase.co/auth/v1/.well-known/jwks.json

# Optional: legacy JWT secret for offline HMAC-SHA256 token verification
# Leave empty when using JWKS verification (do NOT put JWKS URL here).
SUPABASE_JWT_SECRET=

# --- Local development auth bypass ---
# Enables the unsigned-JWT fallback in shared/auth.py's decode_supabase_jwt():
# the backend will accept tokens where alg is "none" (minted by the frontend's
# AuthProvider.tsx mintDevToken() for demo accounts) by trusting the `sub`
# claim with NO signature check.
#
# ⚠️  TWO conditions must BOTH be true for this path to activate:
#   1. AUTH_DEV_MODE=true
#   2. SUPABASE_JWT_SECRET, SUPABASE_JWKS_URL, and SUPABASE_URL must all be
#      absent or empty — if any real Supabase verification config is present,
#      the backend uses that and never reaches this fallback.
#
# Never set true in production or any deployment with a live Supabase project.
# The default is false so a misconfigured deployment fails closed (401) instead
# of silently accepting unsigned tokens.
AUTH_DEV_MODE=false

# --- LLM configuration ---
# Groq primary, Gemini fallback
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-key-here
LLM_MODEL=llama-3.3-70b-versatile

# To fail over to Gemini instead, without touching code:
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-gemini-key-here
# LLM_MODEL=gemini-2.5-flash

# --- Optional: P6 EPPM REST Integration ---
# Leave empty to disable network write-back.
# For local mock P6, use the mock endpoint when the application is running.
P6_BASE_URL=

# --- Optional: Demo Supabase Auth user IDs ---
# Used by canonical seed data.
DEMO_SITE_ENGINEER_USER_ID=
DEMO_SUPERVISOR_USER_ID=

# --- Project site GPS configuration - owned by M4 ---
PROJECT_SITE_LAT=27.4728
PROJECT_SITE_LON=95.3547
PROJECT_SITE_RADIUS_KM=5.0

# --- CORS (comma-separated origins allowed to call this API) ---
# Defaults to the Vite dev server if unset; no need to set this for local dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173